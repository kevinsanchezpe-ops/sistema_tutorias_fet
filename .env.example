# Copy to .env locally. Never commit .env or production credentials.
NODE_ENV=development
PORT=3000

# For a managed database use sslmode=verify-full and a trusted CA certificate.
DATABASE_URL=postgresql://gt_user:CHANGE_ME@localhost:5432/gt_db
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FRONTEND_URL=http://localhost:3000
INSTITUTIONAL_EMAIL_DOMAINS=fet.edu.co

# Límite de participantes por tutoría virtual (incluye a quien la solicitó).
MAX_VIRTUAL_TUTORING_PARTICIPANTS=30
# Solicitudes pendientes se cierran tras 48 horas; las aprobadas que no se inician,
# 24 horas después del final de la franja. El estudiante cancela con 24 h de anticipación.
PENDING_TUTORING_EXPIRY_HOURS=48
APPROVED_TUTORING_NO_SHOW_GRACE_HOURS=24
CANCELLATION_MIN_NOTICE_HOURS=24

# Docker Compose values. Use a hex-only password to keep the DATABASE_URL safe to interpolate.
POSTGRES_USER=gt_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_HEX_PASSWORD
POSTGRES_DB=gt_db

# SMTP is optional in development; production startup requires these values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
