# Backend Environment Variables
DATABASE_URL="postgresql://gt_user:gt_password@localhost:5432/gt_db?schema=public"
JWT_SECRET="super-secret-jwt-key-for-gt-system-development-only"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-for-gt-system"
PORT="3000"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Frontend Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
VITE_API_URL="http://localhost:3000/api"

# GEMINI_API_KEY: Optional AI Studio integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
